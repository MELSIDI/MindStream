{
  "name": "mindstream",
  "displayName": "MindStream — Pair-Programming Synchronisé & Vocal",
  "description": "Transforme l'agent IA en binôme de Pair-Programming humain qui code à votre rythme en expliquant chaque choix à voix haute avec pause, variateur de vitesse, barge-in vocal et mode démo intégré.",
  "version": "0.2.1",
  "publisher": "mindstream",
  "license": "MIT",
  "keywords": [
    "ai",
    "pair-programming",
    "voice",
    "tts",
    "pedagogy",
    "mindstream",
    "gemini",
    "antigravity"
  ],
  "categories": [
    "AI",
    "Education",
    "Programming Languages",
    "Other"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mindstream-studio",
          "title": "MindStream",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "mindstream-studio": [
        {
          "type": "webview",
          "id": "mindstream.studioView",
          "name": "MindStream Mini-HUD"
        }
      ]
    },
    "commands": [
      {
        "command": "mindstream.openStudio",
        "title": "MindStream: Ouvrir le Mini-HUD",
        "icon": "$(radio-tower)"
      },
      {
        "command": "mindstream.quickMenu",
        "title": "MindStream: Menu Rapide"
      },
      {
        "command": "mindstream.installAntigravityPlugin",
        "title": "MindStream: Installer le plugin /MindStream (Antigravity & MCP)",
        "icon": "$(plug)"
      },
      {
        "command": "mindstream.startDemo",
        "title": "MindStream: Lancer la Démo Interactive (Sans clé API)",
        "icon": "$(play)"
      },
      {
        "command": "mindstream.startSession",
        "title": "MindStream: Démarrer une session de Pair-Programming",
        "icon": "$(sparkle)"
      },
      {
        "command": "mindstream.togglePlayPause",
        "title": "MindStream: Lecture / Pause",
        "icon": "$(debug-pause)"
      },
      {
        "command": "mindstream.cycleSpeed",
        "title": "MindStream: Changer la vitesse",
        "icon": "$(dashboard)"
      },
      {
        "command": "mindstream.setSpeed",
        "title": "MindStream: Choisir une vitesse précise",
        "icon": "$(dashboard)"
      },
      {
        "command": "mindstream.bargeIn",
        "title": "MindStream: Interrompre & Poser une question (Barge-in)",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "mindstream.implementFileAndPause",
        "title": "MindStream: Implémenter ce fichier rapidement puis pause",
        "icon": "$(file-code)"
      },
      {
        "command": "mindstream.skipBlock",
        "title": "MindStream: Passer au bloc suivant",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "mindstream.stopSession",
        "title": "MindStream: Arrêter la session",
        "icon": "$(debug-stop)"
      },
      {
        "command": "mindstream.configureApiKey",
        "title": "MindStream: Configurer une clé API (Gemini / OpenAI)",
        "icon": "$(key)"
      },
      {
        "command": "mindstream.toggleMute",
        "title": "MindStream: Couper / Activer la voix",
        "icon": "$(unmute)"
      }
    ],
    "keybindings": [
      {
        "command": "mindstream.togglePlayPause",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "mindstream.hasSession"
      },
      {
        "command": "mindstream.cycleSpeed",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "mindstream.hasSession"
      },
      {
        "command": "mindstream.bargeIn",
        "key": "ctrl+shift+space",
        "mac": "cmd+shift+space",
        "when": "mindstream.hasSession"
      },
      {
        "command": "mindstream.implementFileAndPause",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "mindstream.hasSession"
      },
      {
        "command": "mindstream.skipBlock",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "mindstream.hasSession"
      }
    ],
    "chatParticipants": [
      {
        "id": "mindstream.pair",
        "fullName": "MindStream",
        "name": "mindstream",
        "description": "Pair-programming synchronisé à vitesse humaine & voix (/MindStream)",
        "isSticky": true,
        "commands": [
          {
            "name": "demo",
            "description": "Lancer la démo interactive FocusFlow (sans clé API)"
          },
          {
            "name": "speed",
            "description": "Régler la vitesse (0.5x, 1x, 2x, 3x, auto)"
          },
          {
            "name": "pause",
            "description": "Mettre en pause"
          },
          {
            "name": "resume",
            "description": "Reprendre la lecture"
          },
          {
            "name": "skip",
            "description": "Passer au bloc suivant"
          },
          {
            "name": "file",
            "description": "Implémenter un fichier rapidement puis mettre en pause"
          },
          {
            "name": "stop",
            "description": "Arrêter la session"
          }
        ]
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mindstream.implementFileAndPause",
          "group": "navigation@99"
        }
      ],
      "editor/context": [
        {
          "command": "mindstream.bargeIn",
          "when": "mindstream.hasSession",
          "group": "mindstream@1"
        },
        {
          "command": "mindstream.implementFileAndPause",
          "group": "mindstream@2"
        }
      ],
      "view/title": [
        {
          "command": "mindstream.startDemo",
          "when": "view == mindstream.studioView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "MindStream",
      "properties": {
        "mindstream.language": {
          "type": "string",
          "enum": [
            "fr",
            "en"
          ],
          "default": "fr",
          "description": "Langue de narration, des explications et de l'interface MindStream."
        },
        "mindstream.defaultSpeed": {
          "type": "string",
          "enum": [
            "0.5x",
            "1x",
            "2x",
            "3x",
            "auto"
          ],
          "default": "1x",
          "description": "Vitesse par défaut au démarrage d'une session."
        },
        "mindstream.aiProvider": {
          "type": "string",
          "enum": [
            "auto",
            "gemini",
            "openai-compatible",
            "vscode-lm",
            "demo"
          ],
          "default": "auto",
          "description": "Fournisseur d'IA utilisé pour la recherche, le plan et les réponses au barge-in."
        },
        "mindstream.geminiModel": {
          "type": "string",
          "default": "gemini-4-hydrogen",
          "description": "Modèle Gemini utilisé pour le mode Live AI."
        },
        "mindstream.openaiBaseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "URL de base compatible OpenAI (OpenAI, OpenRouter, Ollama, Groq)."
        },
        "mindstream.openaiModel": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Modèle utilisé avec le fournisseur compatible OpenAI."
        },
        "mindstream.ttsProvider": {
          "type": "string",
          "enum": [
            "auto",
            "webspeech",
            "native",
            "gemini"
          ],
          "default": "auto",
          "description": "Moteur de synthèse vocale (auto choisit Web Speech puis repli OS natif)."
        },
        "mindstream.geminiTtsVoice": {
          "type": "string",
          "default": "Kore",
          "description": "Voix Gemini TTS utilisée lorsque mindstream.ttsProvider est réglé sur 'gemini'."
        },
        "mindstream.voiceRateMultiplier": {
          "type": "number",
          "default": 1.0,
          "minimum": 0.6,
          "maximum": 1.8,
          "description": "Multiplicateur de cadence vocale appliqué par-dessus le profil de vitesse."
        },
        "mindstream.autoResearchIntro": {
          "type": "boolean",
          "default": true,
          "description": "Lire automatiquement à voix haute la synthèse de recherche avant d'écrire la première ligne."
        },
        "mindstream.showInlineAnnotations": {
          "type": "boolean",
          "default": true,
          "description": "Afficher l'annotation discrète en fin de ligne pendant l'écriture synchronisée."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "install:plugin": "node scripts/install-plugin.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
